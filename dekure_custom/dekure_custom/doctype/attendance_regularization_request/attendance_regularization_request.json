  {"fieldname": "latitude", "fieldtype": "Float", "label": "Latitude", "precision": "7", "read_only": 1},
  {"fieldname": "longitude", "fieldtype": "Float", "label": "Longitude", "precision": "7", "read_only": 1},
  {"fieldname": "shift", "fieldtype": "Link", "label": "Shift", "options": "Shift Type", "read_only": 1},
  {"fieldname": "attendance_approver", "fieldtype": "Link", "label": "Shift Approver", "options": "User", "reqd": 1, "read_only": 1},
  {"fieldname": "reason", "fieldtype": "Small Text", "label": "Reason", "reqd": 1, "read_only": 1},
  {"fieldname": "status", "fieldtype": "Select", "label": "Status", "options": "Pending Approval\nApproved\nRejected", "default": "Pending Approval", "read_only": 1, "in_list_view": 1},
  {"fieldname": "submitted_by", "fieldtype": "Link", "label": "Submitted By", "options": "User", "read_only": 1},
