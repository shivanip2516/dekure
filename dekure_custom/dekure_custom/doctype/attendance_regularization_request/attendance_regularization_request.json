 "naming_rule": "Expression",
 "permissions": [
  {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "email": 1, "print": 1, "share": 1},
  {"role": "HR Manager", "read": 1, "write": 1, "report": 1, "export": 1, "email": 1, "print": 1},
  {"role": "Employee", "read": 1, "create": 1, "report": 1, "email": 1, "print": 1}
 ],
